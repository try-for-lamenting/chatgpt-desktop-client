{
  "name": "chatgpt-desktop-client",
  "version": "1.0.0",
  "description": "Custom Electron Client for Cycling Accounts on ChatGPT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.chatgptdesktopclient.app",
    "productName": "ChatGPT Desktop Client",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.2"
  }
}